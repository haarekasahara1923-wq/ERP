# =============================================
# 🏫 UDBA — Universal Day Boarding Academy
# Pinto Park, Gwalior (MP)
# =============================================

# =============================================
# 🗄️ DATABASE (Neon PostgreSQL) — REQUIRED
# =============================================
DATABASE_URL="postgresql://username:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# =============================================
# 🔐 AUTHENTICATION — REQUIRED
# =============================================
JWT_SECRET="your-jwt-secret-minimum-32-characters-change-this"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-minimum-32-characters-change-this"
NEXTAUTH_URL="https://udba.space"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# =============================================
# 🏫 UDBA SINGLE SCHOOL CONFIG — REQUIRED
# Run seed first, then copy the Tenant ID here
# =============================================
NEXT_PUBLIC_SCHOOL_NAME="Universal Day Boarding Academy"
NEXT_PUBLIC_SCHOOL_SLUG="udba"
NEXT_PUBLIC_SCHOOL_ADDRESS="Pinto Park, Gwalior (MP)"
NEXT_PUBLIC_SCHOOL_PHONE="917879337770"
NEXT_PUBLIC_SCHOOL_WHATSAPP="917879337770"
NEXT_PUBLIC_SCHOOL_EMAIL="info@udba.space"
NEXT_PUBLIC_SCHOOL_TENANT_ID=""  # Fill after running: npx tsx prisma/seed.ts

# =============================================
# 🌐 APP CONFIG
# =============================================
NEXT_PUBLIC_APP_NAME="UDBA"
NEXT_PUBLIC_APP_URL="https://udba.space"

# =============================================
# 📧 EMAIL / SMTP
# =============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="info@udba.space"
SMTP_PASS="your-gmail-app-password"
EMAIL_FROM="Universal Day Boarding Academy <info@udba.space>"

# =============================================
# 💬 WHATSAPP API (Meta Business)
# Number: +91 7879337770
# =============================================
WHATSAPP_API_TOKEN="your-whatsapp-api-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-business-account-id"
WHATSAPP_VERIFY_TOKEN="udba-webhook-verify-token-2026"

# =============================================
# 🤖 AI SERVICES (Optional)
# =============================================
OPENAI_API_KEY="sk-your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="gsk_your-groq-api-key"

# =============================================
# 💳 RAZORPAY PAYMENT GATEWAY (Optional)
# =============================================
RAZORPAY_KEY_ID="rzp_live_your-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# =============================================
# 📤 FILE STORAGE (Cloudinary) — REQUIRED
# =============================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# =============================================
# 🔴 REDIS (Upstash) — Optional for caching
# =============================================
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# =============================================
# 📱 SMS API (Optional - MSG91)
# =============================================
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_SENDER_ID="UDBA"
MSG91_TEMPLATE_ID="your-dlt-template-id"

# =============================================
# 🔔 WEB PUSH NOTIFICATIONS (Optional)
# =============================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
